DATABASE_URL="postgresql://ledger:CHANGE_ME@localhost:5432/ledger_capital?schema=public"
# Connexion directe (non poolée), utilisée par Prisma Migrate. En local, même valeur
# que DATABASE_URL. En prod derrière un pooler (Neon/PgBouncer), utiliser la variante
# "unpooled"/"direct" fournie par l'hébergeur de la base.
DIRECT_URL="postgresql://ledger:CHANGE_ME@localhost:5432/ledger_capital?schema=public"

# Base URL publique de l'app, utilisée pour construire les liens dans les emails
# (ex: réinitialisation de mot de passe). En prod sur Vercel, laisser vide : VERCEL_URL
# est utilisé automatiquement. En local, http://localhost:3000 est utilisé par défaut.
# APP_URL=

# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# Delay (in hours) before a pending deposit/withdrawal becomes eligible for manager action.
# Anti-arbitrage cooling-off period referenced in the technical brief (section 2).
PENDING_MOVEMENT_DELAY_HOURS=24

# Optional: override the seeded manager account created by `npm run db:seed`.
SEED_MANAGER_EMAIL=gestionnaire@ledgercapital.local
SEED_MANAGER_PASSWORD=change-me-please

# --- Email (Resend) ---
# Without RESEND_API_KEY, emails are just logged to the console (dev mode).
# Get a key at https://resend.com — free tier is enough for testing.
# RESEND_API_KEY=
# EMAIL_FROM="Ledger Capital <onboarding@resend.dev>"

# --- Exchange API (NOT USED YET — manual trade entry only for this phase) ---
# When exchange integration is added: READ + TRADE permissions ONLY, never WITHDRAWAL.
# Store the key here (server-side env var / secrets manager), never in client code.
# EXCHANGE_API_KEY=
# EXCHANGE_API_SECRET=
