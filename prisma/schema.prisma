// Ledger Capital — schéma de données
// Voir README.md pour le rappel de sécurité sur toute modification touchant
// au NAV, aux frais ou aux mouvements de fonds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Connexion directe (non poolée) utilisée pour les migrations — nécessaire en
  // prod derrière un pooler serverless (Neon/PgBouncer) où DATABASE_URL est poolée.
  // En local, DIRECT_URL peut simplement valoir la même chose que DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  CLIENT
  MANAGER
}

enum Tier {
  STANDARD
  PREMIUM
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MovementType {
  DEPOSIT
  WITHDRAWAL
}

enum MovementStatus {
  PENDING_CONFIRMATION // dépôt : en attente de validation manuelle du gestionnaire
  PENDING_EXECUTION    // retrait : parts déjà déduites, envoi on-chain pas encore effectué
  COMPLETED
  REJECTED
}

enum TradeSource {
  MANUAL
  API_SYNC
}

enum TradeDirection {
  LONG
  SHORT
}

enum FeeType {
  MANAGEMENT
  PERFORMANCE
  TRADING
}

enum UsdcNetwork {
  ETHEREUM
  POLYGON
  BASE
  SOLANA
  TRON
  OTHER
}

enum KycSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CLIENT)
  tier         Tier      @default(STANDARD)
  kycStatus    KycStatus @default(PENDING)
  usdcNetwork  UsdcNetwork?
  usdcAddress  String?
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt    DateTime  @default(now())

  holding           ClientHolding?
  pendingMovements  PendingMovement[] @relation("ClientMovements")
  processedMovements PendingMovement[] @relation("ProcessedByManager")
  trades            Trade[]           @relation("TradeLoggedBy")
  auditLogs         AuditLog[]
  kycSubmissions    KycSubmission[]   @relation("KycSubmittedBy")
  kycReviewed       KycSubmission[]   @relation("KycReviewedBy")
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Revue KYC manuelle : historique des soumissions d'un client (une nouvelle
// soumission possible après un rejet). User.kycStatus reflète toujours le
// résultat de la soumission la plus récente.
model KycSubmission {
  id              String              @id @default(uuid())
  clientId        String
  client          User                @relation("KycSubmittedBy", fields: [clientId], references: [id])
  legalName       String
  documentType    String
  documentNumber  String
  note            String?
  idFrontImage    Bytes?
  idFrontMimeType String?
  idBackImage     Bytes?
  idBackMimeType  String?
  status          KycSubmissionStatus @default(PENDING)
  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?               @relation("KycReviewedBy", fields: [reviewedById], references: [id])
  rejectionReason String?

  @@map("kyc_submissions")
}

// Singleton (une seule ligne) : état courant du pool commun.
model PoolState {
  id                  Int      @id @default(1)
  totalAssets         Decimal  @default(0) @db.Decimal(24, 8)
  totalParts          Decimal  @default(0) @db.Decimal(24, 8)
  cashBuffer          Decimal  @default(0) @db.Decimal(24, 8)
  highWaterMark       Decimal  @default(1) @db.Decimal(24, 8)
  updatedAt           DateTime @updatedAt

  @@map("pool_state")
}

model ClientHolding {
  id       String  @id @default(uuid())
  clientId String  @unique
  client   User    @relation(fields: [clientId], references: [id])
  parts    Decimal @default(0) @db.Decimal(24, 8)

  @@map("client_holdings")
}

model Trade {
  id          String      @id @default(uuid())
  source      TradeSource @default(MANUAL)
  pnlPct      Decimal     @db.Decimal(12, 6) // % de l'AUM total, ex: 5.25 = +5.25% — toujours renseigné, calculé ou saisi directement
  navBefore   Decimal     @db.Decimal(24, 8)
  navAfter    Decimal     @db.Decimal(24, 8)
  totalPartsAtTrade Decimal @db.Decimal(24, 8) // total_parts du pool au moment du trade (constant sur un trade) — permet de reconstituer le $ gagné/perdu
  note        String?
  timestamp   DateTime    @default(now())
  loggedById  String
  loggedBy    User        @relation("TradeLoggedBy", fields: [loggedById], references: [id])

  // Détail optionnel quand le trade est saisi par paire (plutôt qu'en % direct) —
  // conservé pour la traçabilité du registre de trades, pnlPct reste la seule
  // valeur utilisée par le moteur de calcul du NAV/frais.
  pair            String?
  direction       TradeDirection?
  entryPrice      Decimal?        @db.Decimal(24, 8)
  exitPrice       Decimal?        @db.Decimal(24, 8)
  positionSizePct Decimal?        @db.Decimal(7, 4) // % de l'AUM misé sur cette paire
  leverage        Decimal?        @db.Decimal(6, 2) // multiplicateur (1 = spot, pas de levier)

  // Frais prélevés par la/les plateformes de trading (spread, financement, exécution...),
  // déduits avant le calcul de l'impact % sur l'AUM et donc avant la performance fee.
  tradingFeeUsd   Decimal?        @db.Decimal(24, 8)

  feeLedgerEntries FeeLedger[]

  @@map("trades")
}

model FeeLedger {
  id      String   @id @default(uuid())
  type    FeeType
  amount  Decimal  @db.Decimal(24, 8)
  date    DateTime @default(now())
  tradeId String?
  trade   Trade?   @relation(fields: [tradeId], references: [id])

  @@map("fee_ledger")
}

model PendingMovement {
  id              String         @id @default(uuid())
  clientId        String
  client          User           @relation("ClientMovements", fields: [clientId], references: [id])
  type            MovementType
  amount          Decimal        @db.Decimal(24, 8) // montant demandé
  grantedAmount   Decimal?       @db.Decimal(24, 8) // retrait : montant accordé (toujours égal à amount — pas de plafond)
  status          MovementStatus @default(PENDING_CONFIRMATION)
  navAtRequest    Decimal        @db.Decimal(24, 8) // NAV figé au moment de la demande — jamais recalculé à l'approbation
  requestedAt     DateTime       @default(now())
  eligibleAt      DateTime       // requestedAt + délai de traitement (12-24h) avant action gestionnaire possible
  processedAt     DateTime?
  processedById   String?
  processedBy     User?          @relation("ProcessedByManager", fields: [processedById], references: [id])
  txHash          String?        // preuve on-chain une fois le retrait envoyé
  rejectionReason String?

  @@map("pending_movements")
}

// Jeton de réinitialisation de mot de passe — écriture seule sur usedAt (marqué
// consommé, jamais supprimé), expire après un délai court (voir lib/password-reset.ts).
// Seul le hash du jeton est stocké, jamais le jeton en clair.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// Historique du NAV pour le graphique de la vue globale.
model NavSnapshot {
  id          String   @id @default(uuid())
  nav         Decimal  @db.Decimal(24, 8)
  totalAssets Decimal  @db.Decimal(24, 8)
  totalParts  Decimal  @db.Decimal(24, 8)
  reason      String   // INIT | TRADE | DEPOSIT | WITHDRAWAL
  createdAt   DateTime @default(now())

  @@map("nav_snapshots")
}

// Journal d'audit — écriture seule, jamais de update/delete dans le code applicatif.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRole  Role?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@map("audit_log")
}
